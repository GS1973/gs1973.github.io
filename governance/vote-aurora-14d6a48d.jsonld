      "witness": {
        "witnessAlgorithm": "ed25519",
        "publicKey": "179f7fcb76adfd21200c26b549a661f815f3fed43ed7577ee8008176d1f72b3f",
        "signature": "dd861f618bf65259f219cf2ecab4a7b0b7cd744cd9c710b14d04c6becfc942f2179ad849a607dcf021684e27340926342097fe5b7c56e61f3944fb4b32b3e500"
