      "name": "Smit Blockchain Operations (BKIND)",
      "witness": {
        "witnessAlgorithm": "ed25519",
        "publicKey": "179f7fcb76adfd21200c26b549a661f815f3fed43ed7577ee8008176d1f72b3f",
        "signature": "16c3e41cb71a7ecf9047216ddb5dd5a56967da57518918c564c952a83fd338b7cf5dfa84a80b21b1141d003882124a0709aab3d3d8365221b2def0344b5a5d0d"
