      "name": "Smit Blockchain Operations (BKIND)",
      "witness": {
        "witnessAlgorithm": "ed25519",
        "publicKey": "179f7fcb76adfd21200c26b549a661f815f3fed43ed7577ee8008176d1f72b3f",
        "signature": "e3845453a99bbbd03fe2c751e9fe6330ce7c8721457903fe0922db5000fc00e6e86eba52ddf393b0db793566e00de200b8d58f7b6b35504eb4f0207844397e00"
